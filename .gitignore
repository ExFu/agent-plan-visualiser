# IDE / tooling state — not project content
.idea/
.omc/

# macOS
.DS_Store

# Backfill / extraction scratch — output of dry-runs + sample extractions.
# Persistent backfill output should live in target projects' .agent-plan-tracker/,
# not here.
_scratch/

# Background-agent worktrees (Claude agent SDK creates these for isolation)
.claude/worktrees/

# agent-plan-tracker local-only data: shadow data dir for M2 shadow-dev
# (APT_DATA_DIR target), and the local capture timestamp consumed by the
# capture-guard hook.
.agent-plan-tracker-auto/
.agent-plan-tracker/.last-capture

# Python bytecode cache (scripts/ now imports aptlib, which generates this)
__pycache__/
