# IDE / tooling state — not project content
.idea/
.omc/

# macOS
.DS_Store

# Backfill / extraction scratch — output of dry-runs + sample extractions.
# Persistent backfill output should live in target projects' .agent-plan-tracker/,
# not here.
_scratch/

# Background-agent worktrees (Claude agent SDK creates these for isolation)
.claude/worktrees/

# agent-plan-visualiser local-only data: shadow data dir for M2 shadow-dev
# (APV_DATA_DIR target), and the local capture timestamp consumed by the
# capture-guard hook.
.agent-plan-tracker-auto/
.agent-plan-tracker/.last-capture

# Python bytecode cache (scripts/ now imports apvlib, which generates this)
__pycache__/

# Distribution bundles — derived output of scripts/build-bundle.sh, never
# committed; the vendored tree stays the dev home (T3-distribution §6 Q2).
dist/

# Editor/agent-plugin local state — never plugin content.
.omc/
