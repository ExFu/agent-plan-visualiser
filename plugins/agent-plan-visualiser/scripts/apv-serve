#!/usr/bin/env bash
# apv-serve — start the APV view server for the current project.
#
# Run it from anywhere inside a tracked repo; serve.py resolves the caller's
# repo from cwd (apvlib.repo_root) and the view/schemas from the toolchain
# home. Symlink-safe: the toolchain home is resolved from this file's REAL
# location, so `ln -s <toolchain>/scripts/apv-serve serve` in a project gives a
# one-word `./serve`.
#
# Usage: apv-serve [--port 8765] [--host 127.0.0.1]
set -euo pipefail
SELF="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
TOOLCHAIN="$(dirname "$(dirname "$SELF")")"
source "$TOOLCHAIN/scripts/python-runtime.sh"
apv_resolve_python jsonschema yaml || exit 2
exec "$APV_PYTHON" "$TOOLCHAIN/scripts/serve.py" "$@"
